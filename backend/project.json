{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "backend/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node --project ./backend/tsconfig.app.json ./node_modules/typeorm/cli.js migration:generate ./backend/src/app/database/migrations/migration -d ./backend/src/app/database/datasource.ts"
      }
    },
    "import-cards": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./backend/import-cards-scryfall.ts ./importableFiles/default-cards-20260423090859.json"
      }
    },
    "build": {
      "outputs": ["{options.outputPath}"],
      "executor": "@nx/webpack:webpack",
      "options": {
        "outputPath": "dist/apps/backend",
        "webpackConfig": "backend/webpack.config.js"
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "backend:build",
        "watch": false
      }
    }
  }
}
